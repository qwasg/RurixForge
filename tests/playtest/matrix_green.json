    { "name": "脚本 speed>1", "assert": { "kind": "component_field", "entity": "Player", "type": "Script", "field": "props.props.speed", "op": "gt", "expected": 1.0 } },
    { "name": "脚本 keys=1", "assert": { "kind": "component_field", "entity": "Player", "type": "Script", "field": "props.props.keys", "expected": 1 } }
  ]
}
