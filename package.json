{
  "name": "rurix-forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:host": "pnpm --filter @forge/host dev",
    "dev:client": "pnpm --filter @forge/client dev",
    "dev:desktop": "pnpm --filter @forge/desktop dev",
    "test:rust": "cargo test --workspace",
    "test:go": "go -C gateway-go test ./...",
    "smoke:f0": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/f0-stack-smoke.ps1"
  }
}
