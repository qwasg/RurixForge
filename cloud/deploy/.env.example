# forge-cloud 生产部署环境变量：复制为 cloud/deploy/.env 后修改（.env 不要提交）。
# 完整变量表见 15_CLOUD_SERVICE.md §1.1。

# 对外地址（桌面端「服务器地址」与 API Key 配置片段都用它）
FORGE_CLOUD_PUBLIC_URL=https://cloud.example.com
# 启用 --profile https 时 Caddy 申请证书的域名
FORGE_CLOUD_DOMAIN=cloud.example.com
# 直接暴露 8110 时改成 0.0.0.0（默认只绑本机，由 Caddy/nginx 反代）
FORGE_CLOUD_BIND=127.0.0.1

POSTGRES_PASSWORD=change-me

# openssl rand -base64 48
FORGE_CLOUD_JWT_SECRET=
# openssl rand -base64 32 （32 字节；丢失后已保存的上游凭据将无法解密）
FORGE_CLOUD_MASTER_KEY=

# 首次启动自动创建的管理员（已有管理员时忽略）
FORGE_CLOUD_ADMIN_EMAIL=admin@example.com
FORGE_CLOUD_ADMIN_PASSWORD=change-me-now

# 反代后取真实客户端 IP（登录限速、审计用）
FORGE_CLOUD_TRUST_PROXY=1
FORGE_CLOUD_LOG_LEVEL=info

# 访问上游（OpenAI/ChatGPT/Anthropic）需要代理时设置；账号级 proxyUrl 优先
# FORGE_CLOUD_UPSTREAM_PROXY=http://127.0.0.1:7890

# 邮箱验证码（可选；不配则注册不做邮箱验证）
# FORGE_CLOUD_SMTP_HOST=smtp.example.com
# FORGE_CLOUD_SMTP_PORT=587
# FORGE_CLOUD_SMTP_USER=no-reply@example.com
# FORGE_CLOUD_SMTP_PASSWORD=
# FORGE_CLOUD_SMTP_FROM=RurixForge <no-reply@example.com>
