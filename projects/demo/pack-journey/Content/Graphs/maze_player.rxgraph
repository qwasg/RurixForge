{
  "version": 1,
  "id": "g_maze_player",
  "name": "MazePlayer",
  "exposedProps": [],
  "nodes": [
    { "id": "st", "type": "event.on_start", "pos": [0, 0] },
    { "id": "o1", "type": "var.set", "pos": [1, 0], "inputs": { "name": { "const": "-1" }, "value": { "const": [0, 0, -2] } } },
    { "id": "o2", "type": "var.set", "pos": [2, 0], "inputs": { "name": { "const": "1" }, "value": { "const": [0, 0, 2] } } },
    { "id": "o3", "type": "var.set", "pos": [3, 0], "inputs": { "name": { "const": "-10" }, "value": { "const": [-2, 0, 0] } } },
    { "id": "o4", "type": "var.set", "pos": [4, 0], "inputs": { "name": { "const": "10" }, "value": { "const": [2, 0, 0] } } },
    { "id": "sc", "type": "var.set", "pos": [5, 0], "inputs": { "name": { "const": "cell" }, "value": { "const": 11 } } },
    { "id": "sh", "type": "var.set", "pos": [6, 0], "inputs": { "name": { "const": "hasKey" }, "value": { "const": false } } },
    { "id": "p1", "type": "call.call_function", "pos": [7, 0], "inputs": { "module": { "const": "Content/Scripts/maze.rx" }, "fn": { "const": "open_at_cell" }, "args": { "const": [22] } } },
    { "id": "b1", "type": "flow.branch", "pos": [8, 0], "inputs": { "condition": { "node": "p1", "pin": "result" } } },
    { "id": "p2", "type": "call.call_function", "pos": [9, 0], "inputs": { "module": { "const": "Content/Scripts/maze.rx" }, "fn": { "const": "open_at_cell" }, "args": { "const": [11] } } },
    { "id": "b2", "type": "flow.branch", "pos": [10, 0], "inputs": { "condition": { "node": "p2", "pin": "result" } } },
    { "id": "lg1", "type": "debug.log", "pos": [11, 0], "inputs": { "message": { "const": "maze rules ok" } } },
    { "id": "lg2", "type": "debug.log", "pos": [11, 1], "inputs": { "message": { "const": "maze BROKEN" } } },
    { "id": "lg3", "type": "debug.log", "pos": [9, 1], "inputs": { "message": { "const": "maze BROKEN" } } },

    { "id": "in", "type": "event.on_input", "pos": [0, 2] },
    { "id": "s0", "type": "var.set", "pos": [1, 2], "inputs": { "name": { "const": "cand" }, "value": { "node": "gcell", "pin": "out" } } },
    { "id": "gcell", "type": "var.get", "pos": [0, 3], "inputs": { "name": { "const": "cell" } } },
    { "id": "a0", "type": "var.add", "pos": [2, 2], "inputs": { "name": { "const": "cand" }, "value": { "node": "in", "pin": "value" } } },
    { "id": "cw", "type": "call.call_function", "pos": [3, 2], "inputs": { "module": { "const": "Content/Scripts/maze.rx" }, "fn": { "const": "open_at_cell" }, "args": { "node": "g0", "pin": "out" } } },
    { "id": "g0", "type": "var.get", "pos": [2, 3], "inputs": { "name": { "const": "cand" } } },
    { "id": "bw", "type": "flow.branch", "pos": [4, 2], "inputs": { "condition": { "node": "cw", "pin": "result" } } },
    { "id": "lw", "type": "debug.log", "pos": [5, 1], "inputs": { "message": { "const": "wall bump" } } },
    { "id": "cd", "type": "call.call_function", "pos": [5, 2], "inputs": { "module": { "const": "Content/Scripts/maze.rx" }, "fn": { "const": "not_door_cell" }, "args": { "node": "g0", "pin": "out" } } },
    { "id": "bd", "type": "flow.branch", "pos": [6, 2], "inputs": { "condition": { "node": "cd", "pin": "result" } } },
    { "id": "bh", "type": "flow.branch", "pos": [7, 2], "inputs": { "condition": { "node": "gk", "pin": "out" } } },
    { "id": "gk", "type": "var.get", "pos": [6, 3], "inputs": { "name": { "const": "hasKey" } } },
    { "id": "ld", "type": "debug.log", "pos": [8, 1], "inputs": { "message": { "const": "door needs key" } } },
    { "id": "s1", "type": "var.set", "pos": [8, 2], "inputs": { "name": { "const": "cell" }, "value": { "node": "g0", "pin": "out" } } },
    { "id": "mv", "type": "transform.move_tween", "pos": [9, 2], "inputs": { "target": { "const": "$self" }, "offset": { "node": "go", "pin": "out" }, "duration": { "const": 0.15 } } },
    { "id": "go", "type": "var.get", "pos": [8, 3], "inputs": { "name": { "node": "in", "pin": "action" } } },

    { "id": "ms", "type": "event.on_message", "pos": [0, 4] },
    { "id": "sk", "type": "var.set", "pos": [1, 4], "inputs": { "name": { "const": "hasKey" }, "value": { "const": true } } },
    { "id": "lk", "type": "debug.log", "pos": [2, 4], "inputs": { "message": { "const": "key taken" } } }
  ],
  "edges": [
    { "from": ["st", "exec"], "to": ["o1", "exec"] },
    { "from": ["o1", "exec"], "to": ["o2", "exec"] },
    { "from": ["o2", "exec"], "to": ["o3", "exec"] },
    { "from": ["o3", "exec"], "to": ["o4", "exec"] },
    { "from": ["o4", "exec"], "to": ["sc", "exec"] },
    { "from": ["sc", "exec"], "to": ["sh", "exec"] },
    { "from": ["sh", "exec"], "to": ["p1", "exec"] },
    { "from": ["p1", "exec"], "to": ["b1", "exec"] },
    { "from": ["b1", "then"], "to": ["lg3", "exec"] },
    { "from": ["b1", "else"], "to": ["p2", "exec"] },
    { "from": ["p2", "exec"], "to": ["b2", "exec"] },
    { "from": ["b2", "then"], "to": ["lg1", "exec"] },
    { "from": ["b2", "else"], "to": ["lg2", "exec"] },

    { "from": ["in", "exec"], "to": ["s0", "exec"] },
    { "from": ["s0", "exec"], "to": ["a0", "exec"] },
    { "from": ["a0", "exec"], "to": ["cw", "exec"] },
    { "from": ["cw", "exec"], "to": ["bw", "exec"] },
    { "from": ["bw", "then"], "to": ["cd", "exec"] },
    { "from": ["bw", "else"], "to": ["lw", "exec"] },
    { "from": ["cd", "exec"], "to": ["bd", "exec"] },
    { "from": ["bd", "then"], "to": ["s1", "exec"] },
    { "from": ["bd", "else"], "to": ["bh", "exec"] },
    { "from": ["bh", "then"], "to": ["s1", "exec"] },
    { "from": ["bh", "else"], "to": ["ld", "exec"] },
    { "from": ["s1", "exec"], "to": ["mv", "exec"] },

    { "from": ["ms", "exec"], "to": ["sk", "exec"] },
    { "from": ["sk", "exec"], "to": ["lk", "exec"] }
  ]
}
